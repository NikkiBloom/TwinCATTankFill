<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TankSM" Id="{fccd4b83-08ed-42ee-a48d-bce3d96b8d5a}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_TankSM
VAR_INPUT
	bSensHIGH, bSensLOW	: BOOL;
	bFaultClear			: BOOL;
	bBusOK				: BOOL;
	bTankFault				: BOOL;
	
	eTankFaultCode		: E_TankFault;
	eSystemState		: E_SystemState;
	
	// passed in from TankCrontrol to go to Main
	bValveIn    : BOOL;
    bValveOut   : BOOL;
    bPump       : BOOL;
END_VAR
VAR_OUTPUT
	eTankState				: E_TankState;
	
	// pass from TankControl to Main
	bOutValveIn				: BOOL;
	bOutValveOut			: BOOL;
	bOutPump				: BOOL;
END_VAR
VAR_IN_OUT
	bAutoMode			: BOOL;
END_VAR
VAR
	TankCTRL	: FB_TankControl;
	
    tonEmptyDelay     : TON;
	tonPumpStartDelay : TON;
	tonStayFull		  : TON;
	tEmptyDelay       : TIME := T#2S;
	tPumpStartDelay   : TIME := T#3S;
	tStayFullTime	  : TIME := T#3S;
	
	bcmdOpenValveIn 		: BOOL;
	bcmdOpenValveOut		: BOOL;
	bcmdPumpOn				: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// State Machine for the Tank

IF NOT bAutoMode THEN
	eTankState := 40;
END_IF
IF eSystemState = 99 OR bTankFault THEN
	eTankState := 99;
END_IF

tonEmptyDelay(IN := (eTankState = 35), PT := tEmptyDelay);
tonPumpStartDelay(IN := (eTankState = 10), PT := tPumpStartDelay);
tonStayFull(IN := (eTankState = 20), PT := tStayFullTime);

CASE eTankState OF
	0://IDLE 
		IF NOT bSensHIGH AND NOT bSensLOW THEN // Empty
			eTankState := 35;
		ELSIF bSensLOW THEN //If between sensors then go to filling
			eTankState := 10;
		ELSE // if high then drain
			eTankState := 30;
		END_IF
	10://FILLING
	bcmdOpenValveIn := TRUE;
		bcmdPumpOn := TRUE;
		 IF tonPumpStartDelay.Q AND bSensHIGH THEN
			bcmdOpenValveIn := FALSE; // close in valve; full
			eTankState := 20;
		END_IF
	20://FULL
		IF tonStayFull.Q THEN
			eTankState := 30; // drain after 3s
		ELSIF NOT bSensHIGH THEN // if no longer high then trigger into idle
			bcmdPumpOn := FALSE;
			eTankState := 0;
		END_IF
	30: // DRAINING
		bcmdOpenValveOut := TRUE;
        IF NOT bSensLOW THEN
            bcmdOpenValveOut := FALSE;
            eTankState := 35;
        END_IF
    35: // EMPTY - hold 2 s before starting to fill
        IF tonEmptyDelay.Q THEN
            eTankState := 10;
        END_IF
	40://MANUAL
		IF bAutoMode THEN
			eTankState := 0;
		END_IF
	99://FAULT
		bcmdPumpOn := FALSE;
		IF bFaultClear THEN
			eTankState := 0;
		END_IF
END_CASE

TankCTRL(
    // Commands from the state machine
    cmdOpenValveIn  := bcmdOpenValveIn,
    cmdOpenValveOut := bcmdOpenValveOut,
    cmdPumpOn       := bcmdPumpOn,
    bAutoMode       := bAutoMode,

    // Status
    bFault          => bTankFault,
    eFaultCode      => eTankFaultCode,
    bBusOK          => bBusOK,

    // Final outputs, passed straight through to MAIN
    bValveIn        => bOutValveIn,
    bValveOut       => bOutValveOut,
    bPump           => bOutPump
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>