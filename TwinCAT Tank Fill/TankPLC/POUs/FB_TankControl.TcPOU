<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TankControl" Id="{df9f4825-9186-41f7-9f2e-6c7610063879}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_TankControl
VAR_INPUT
	// COMMANDS SENT BY SM
	cmdOpenValveIn 		: BOOL;
	cmdOpenValveOut		: BOOL;
	cmdPumpOn			: BOOL;
	
	bAutoMode			: BOOL;
END_VAR
VAR_OUTPUT
	bFault				: BOOL;
	eFaultCode			: E_TankFault;
	bBusOK				: BOOL; //EtherCAT
	
	bValveIn    : BOOL;
    bValveOut   : BOOL;
    bPump       : BOOL;
END_VAR
VAR_IN_OUT
END_VAR
VAR
		HMI					: ST_TankHMI;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Does the physical switching for FB_TankSM

IF bAutoMode THEN
	IF cmdOpenValveIn THEN
		bValveIn := TRUE;
	ELSE
		bValveIn := FALSE;
	END_IF
	IF cmdOpenValveOut THEN
		bValveOut := TRUE;
	ELSE
		bValveOut := FALSE;
	END_IF
	IF cmdPumpOn THEN
		bPump := TRUE;
	ELSE
		bPump := FALSE;
	END_IF
ELSE
	Manual();
END_IF]]></ST>
    </Implementation>
    <Method Name="Manual" Id="{f525ffa6-9ea1-419d-a9b8-7d16ddd7267b}">
      <Declaration><![CDATA[METHOD Manual : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// When running a tank manually, simply pass raw HMI inputs
// just push raw inputs
bValveIn  := GVL_HMI.Tank1.bPB_ValveIn;
bValveOut := GVL_HMI.Tank1.bPB_ValveOut;
bPump     := GVL_HMI.Tank1.bPB_Pump;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>