<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAIN" Id="{c4315efa-39c9-470b-8c60-2c2ca0a0bcf4}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	// Create instance of FB
	Tank1SM : FB_TankSM;
	
	// Internal Bools to handle I/O inputs
	bEStopPressed 	: BOOL; // TRUE = PRESSED (inverted from raw)
	bSensHIGH		: BOOL;
	bSensLOW		: BOOL;
	bBusOK			: BOOL := TRUE; // Practical IRL but unused in this simulation.
	
	// Timers
	tTankfillTimeout	: TIME := T#120S; 
	
	// FB Outputs
	bValveInCMD		: BOOL;
	bValveOutCMD	: BOOL;
	bPumpCMD		: BOOL;
	bTankFault		: BOOL;
	bAutoMode		: BOOL;
	
	eTankState		: E_TankState;
	eTankFaultCode  : E_TankFault;
	eSystemState	: E_SystemState;
	
	// Plant-level
	bOutputsDisabled : BOOL; // practical IRL for maitinence lockout, but unused in this simulation
	fbHeartbeat		: TON;
	bHeartbeat		: BOOL;
	
	// ---- Simulation ----
    fbSim            : FB_TankPlantSim;
    bSimMode         : BOOL := TRUE;     // TRUE = no hardware, use fbSim
    bSimEStop        : BOOL;             // HMI toggle: simulated e-stop pressed
    bSimBusOK        : BOOL := TRUE;     // HMI toggle: simulated bus health
	// Final outputs after plant-level overrides 
    bOutValveIn      : BOOL;
    bOutValveOut     : BOOL;
    bOutPump         : BOOL;


END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Main will primarily call function blocks in order

// Pull in I/O Inputs from GVL (or in this case, the SIM)
bSensHIGH     := fbSim.bSensHIGH;
bSensLOW      := fbSim.bSensLOW;
bEStopPressed := bSimEStop;
bAutoMode     := GVL_HMI.Tank1.bAutoMode; 
(* This is what it would look like as GVL *)(*    
bEStopPressed := NOT GVL_IO.bEStop_RAW; 
bSensHIGH     := GVL_IO.bSensHigh_RAW;    
bSensLOW      := GVL_IO.bSensLow_RAW;
*)


// HMI COMMAND HANDLING
// This program was designed under the assumption that this MAIN may manage more than one tank.
// As such, most of the IO reaction is handled by the FB's, and results passed in the next section.

// FB CALL sysSM -> tankSM -> pumpSM -> simSM
Tank1SM(
	// These go INTO the FB :=
	bSensHIGH	:= bSensHIGH,
	bSensLOW	:= bSensLOW,
	eSystemState := eSystemState,
	
	// These come OUT of the FB =>
	eTankState => eTankState,
	bOutValveIn	=> bValveInCMD,
	bOutValveOut => bValveOutCMD,
	bOutPump => bPumpCMD,
	// VAR_IN_OUT
	bAutoMode	:= bAutoMode
);

// OUTPUT MAPING
// Plant-level overrides such as E-Stop presses, bus fault, etc. 
// For this exercise, it's not simulated but still here.
IF bOutputsDisabled OR NOT bBusOK OR bEStopPressed THEN // if something wrong, soft stop
    bOutValveIn  := FALSE;
    bOutValveOut := FALSE;
    bOutPump     := FALSE;
ELSE 
    bOutValveIn  := bValveInCMD;
    bOutValveOut := bValveOutCMD;
    bOutPump     := bPumpCMD;
END_IF;

IF bSimMode THEN
    fbSim(
        bValveIn  := bOutValveIn,
        bValveOut := bOutValveOut,
        bPump     := bOutPump,
        tCycle    := T#10MS             
    );
    GVL_HMI.Tank1.rLevel := fbSim.rLevel;

    GVL_IO.bValveIn  := FALSE;          
    GVL_IO.bValveOut := FALSE;
    GVL_IO.bPump     := FALSE;
ELSE
    GVL_IO.bValveIn  := bOutValveIn;
    GVL_IO.bValveOut := bOutValveOut;
    GVL_IO.bPump     := bOutPump;
END_IF;


// STATUS AND DIAGNOSTICS
// Things like heartbeat, warning flags, etc.
fbHeartbeat(IN := NOT fbHeartbeat.Q, PT := T#500MS);
IF fbHeartbeat.Q THEN
    bHeartbeat := NOT bHeartbeat;
END_IF;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>